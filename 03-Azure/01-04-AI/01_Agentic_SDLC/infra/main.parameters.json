{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "_comment_location": "TODO: Set a region with Container Apps capacity (e.g. eastus, westeurope). Defaults to the resource group location if omitted.",
    "namePrefix": {
      "value": "octocat"
    },
    "environmentName": {
      "value": "dev"
    },
    "_comment_images": "Image values are overridden by the deployment workflow after it builds and pushes both images.",
    "apiImage": {
      "value": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest"
    },
    "frontendImage": {
      "value": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest"
    },
    "minReplicas": {
      "value": 1
    },
    "maxReplicas": {
      "value": 3
    },
    "managedIdentityResourceId": {
      "value": "/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.ManagedIdentity/userAssignedIdentities/<identity-name>"
    }
  }
}
